# Copy to backend/.env. Never commit the real file.
# AI provider (optional: without it the app still performs full static analysis)
TSA_AI_PROVIDER=
TSA_AI_MODEL=
TSA_AI_API_KEY=
TSA_AI_TIMEOUT_SECONDS=60

# Limits
TSA_MAX_UPLOAD_BYTES=1000000
TSA_MAX_ZIP_BYTES=20000000
TSA_MAX_FILE_BYTES=1000000
TSA_MAX_EXTRACTED_FILES=500
TSA_MAX_EXTRACTED_BYTES=50000000
TSA_MAX_COMPRESSION_RATIO=200
TSA_TOOL_TIMEOUT_SECONDS=60

# Storage
TSA_DB_PATH=data/techspecanalyser.db
TSA_RETENTION_DAYS=90

# GitHub Push & Webhook Integration
# Webhook secret used to verify X-Hub-Signature-256 HMAC-SHA256 signatures from GitHub
GITHUB_WEBHOOK_SECRET=your_secure_random_webhook_secret_here

# Optional GitHub Personal Access Token (PAT) for higher API rate limits on public/private repos
GITHUB_TOKEN=

# Optional custom GitHub Enterprise / mock API base URL (defaults to https://api.github.com)
GITHUB_API_BASE_URL=https://api.github.com
